@{
    // Açık sekme menüde programatik olarak işaretlenir (spec 0004 AC-1); null öznitelik hiç yazılmaz.
    string? AcikSekme(string sayfa) =>
        string.Equals(ViewContext.RouteData.Values["page"] as string, sayfa, StringComparison.Ordinal) ? "page" : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Baslik"] — PolsanIzin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <span class="uygulama-adi">PolsanIzin</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @* Menüde yalnızca var olan sayfalar bulunur; diğer öğeleri kendi spec'leri ekler (spec 0002 R-13). *@
            <nav aria-label="Ana menü">
                <ul>
                    <li><a asp-page="/Index" aria-current="@AcikSekme("/Index")">Ana Sayfa</a></li>
                    <li><a asp-page="/Izinler/Olustur" aria-current="@AcikSekme("/Izinler/Olustur")">İzin Talebi Oluştur</a></li>
                    <li><a asp-page="/Izinler/Taleplerim" aria-current="@AcikSekme("/Izinler/Taleplerim")">Taleplerim</a></li>
                    <li><a asp-page="/Izinler/Gecmis" aria-current="@AcikSekme("/Izinler/Gecmis")">Geçmiş</a></li>
                    <li>
                        <form method="post" asp-page="/Cikis">
                            <button type="submit">Çıkış</button>
                        </form>
                    </li>
                </ul>
            </nav>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
