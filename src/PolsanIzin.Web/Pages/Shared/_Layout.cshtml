<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Baslik"] — PolsanIzin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <span class="uygulama-adi">PolsanIzin</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @* Menüde yalnızca var olan sayfalar bulunur; diğer öğeleri kendi spec'leri ekler (spec 0002 R-13). *@
            <nav aria-label="Ana menü">
                <ul>
                    <li><a asp-page="/Index">Ana Sayfa</a></li>
                    <li>
                        <form method="post" asp-page="/Cikis">
                            <button type="submit">Çıkış</button>
                        </form>
                    </li>
                </ul>
            </nav>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
