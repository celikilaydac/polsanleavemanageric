@page
@model IndexModel
@{
    ViewData["Baslik"] = "Ana Sayfa";
}

<section class="kart">
    <h1>Hoş geldiniz, @Model.AdSoyad</h1>

    <p class="aciklama-metni">Rolleriniz:</p>
    <ul class="roller">
        @foreach (var rol in Model.Roller)
        {
            <li>@rol</li>
        }
    </ul>
</section>
