root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Düzen
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# var ve ifade tercihleri
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# İsimlendirme: private alanlar _camelCase
dotnet_naming_rule.private_alanlar.symbols = private_alanlar
dotnet_naming_rule.private_alanlar.style = alt_cizgili_camel
dotnet_naming_rule.private_alanlar.severity = warning
dotnet_naming_symbols.private_alanlar.applicable_kinds = field
dotnet_naming_symbols.private_alanlar.applicable_accessibilities = private
dotnet_naming_style.alt_cizgili_camel.capitalization = camel_case
dotnet_naming_style.alt_cizgili_camel.required_prefix = _

# Arayüzler I önekli
dotnet_naming_rule.arayuzler.symbols = arayuzler
dotnet_naming_rule.arayuzler.style = i_onekli
dotnet_naming_rule.arayuzler.severity = warning
dotnet_naming_symbols.arayuzler.applicable_kinds = interface
dotnet_naming_style.i_onekli.capitalization = pascal_case
dotnet_naming_style.i_onekli.required_prefix = I

# Türkçe tanımlayıcılar ve test adları (Metot_Durum_BeklenenSonuc) analizörle çatışmasın
dotnet_diagnostic.CA1707.severity = none
# Kütüphane değil uygulama: ConfigureAwait zorunlu değil
dotnet_diagnostic.CA2007.severity = none
# Yerelleştirme analizörleri: arayüz metni zaten Türkçe
dotnet_diagnostic.CA1303.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
